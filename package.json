{
  "name": "summergamefest",
  "type": "module",
  "version": "0.0.0",
  "author": "BeeeQueue <adam@haglund.dev>",
  "repository": "https://github.com/BeeeQueue/isthepatchout",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^26"
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,json5,yaml,yml,css,scss,md}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint src",
    "prepare": "simple-git-hooks && svelte-kit sync",
    "start": "node build/index.js",
    "test": "vitest",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#/*": "./src/*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@iconify-json/lucide": "1.2.146",
    "@iconify-json/simple-icons": "1.2.100",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.5",
    "@unocss/cli": "66.11.0",
    "@unocss/extractor-svelte": "66.11.0",
    "@unocss/preset-icons": "66.11.0",
    "@unocss/preset-web-fonts": "66.11.0",
    "@unocss/preset-wind3": "66.11.0",
    "@unocss/reset": "66.11.0",
    "@unocss/transformer-compile-class": "66.11.0",
    "@unocss/transformer-directives": "66.11.0",
    "@unocss/vite": "66.11.0",
    "alleviate": "0.2.3",
    "canvas-confetti": "1.9.4",
    "croner": "10.0.1",
    "dotaver": "2.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "evlog": "2.33.1",
    "nano-staged": "1.0.2",
    "oxfmt": "0.73.0",
    "simple-git-hooks": "2.14.0",
    "sonda": "0.14.0",
    "strip-indent": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "web-push": "3.6.7",
    "xior": "0.8.5"
  }
}
