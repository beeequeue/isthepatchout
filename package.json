{
  "name": "isthepatchout",
  "type": "module",
  "version": "0.0.0",
  "author": "BeeeQueue <adam@haglund.dev>",
  "homepage": "https://isthepatchout.com",
  "repository": "https://github.com/BeeeQueue/isthepatchout",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "^24"
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,json5,yaml,yml,css,scss,md}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "lint": "eslint .",
    "postinstall": "simple-git-hooks",
    "psql": "PGPASSWORD=postgres psql -h localhost -p 54322 -U postgres -f",
    "serve": "nuxi preview",
    "supabase:start": "supabase start -x storage-api,imgproxy,inbucket,studio,deno-relay,edge-runtime,logflare",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@vueuse/core": "14.3.0",
    "canvas-confetti": "1.9.4",
    "dotaver": "2.0.1",
    "p-queue": "9.3.1",
    "pino": "10.3.1",
    "temporal-polyfill-lite": "0.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.1.0",
    "@iconify-json/simple-icons": "1.2.91",
    "@iconify-json/tabler": "1.2.37",
    "@morev/vue-transitions": "3.0.5",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxtjs/supabase": "2.0.9",
    "@supabase/realtime-js": "2.110.8",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.1.0",
    "@unocss/nuxt": "66.7.5",
    "@unocss/preset-wind3": "66.7.5",
    "@unocss/reset": "66.7.5",
    "@unocss/transformer-directives": "66.7.5",
    "@vueuse/nuxt": "14.3.0",
    "eslint": "10.7.0",
    "nano-staged": "1.0.2",
    "nuxt": "4.5.0",
    "nuxt-security": "2.6.0",
    "ofetch": "2.0.0-alpha.3",
    "oxfmt": "0.59.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3",
    "valibot": "1.4.2",
    "vue": "3.5.40",
    "vue-tsc": "3.3.7"
  }
}
