{
  "name": "summergamefest",
  "type": "module",
  "version": "0.0.0",
  "author": "BeeeQueue <adam@haglund.dev>",
  "repository": "https://github.com/BeeeQueue/isthepatchout",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^26"
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,json5,yaml,yml,css,scss,md}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint src",
    "prepare": "simple-git-hooks && svelte-kit sync",
    "start": "node build/index.js",
    "test": "vitest",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#/*": "./src/*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@iconify-json/lucide": "1.2.118",
    "@iconify-json/simple-icons": "1.2.91",
    "@sveltejs/adapter-node": "6.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.12",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tsconfig/node26": "26.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.1.1",
    "@unocss/cli": "66.7.5",
    "@unocss/extractor-svelte": "66.7.5",
    "@unocss/preset-icons": "66.7.5",
    "@unocss/preset-web-fonts": "66.7.5",
    "@unocss/preset-wind3": "66.7.5",
    "@unocss/reset": "66.7.5",
    "@unocss/transformer-compile-class": "66.7.5",
    "@unocss/transformer-directives": "66.7.5",
    "@unocss/vite": "66.7.5",
    "alleviate": "0.2.3",
    "canvas-confetti": "1.9.4",
    "croner": "10.0.1",
    "dotaver": "2.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "evlog": "2.22.3",
    "nano-staged": "1.0.2",
    "oxfmt": "0.60.0",
    "simple-git-hooks": "2.13.1",
    "sonda": "0.14.0",
    "strip-indent": "4.1.1",
    "svelte": "5.56.7",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "valibot": "1.4.2",
    "vite": "8.1.5",
    "vitest": "5.0.0-beta.6",
    "web-push": "3.6.7",
    "xior": "0.8.3"
  }
}
